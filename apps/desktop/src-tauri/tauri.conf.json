{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fellowship",
  "version": "0.0.4",
  "identifier": "dev.fellowship.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "The people in your life, on your own machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server/": "server/",
      "resources/ui/": "ui/"
    }
  }
}
