{
  "name": "@fellowship/mini-host",
  "version": "0.0.8",
  "private": true,
  "description": "The standalone host: the ports, POST /rpc, the media route and the stdio MCP server, in one Node process that owns the SQLite file.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fellowship-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fellowship/core": "workspace:*",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.21",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "files": [
    "dist"
  ]
}
