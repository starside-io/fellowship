{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "outDir": "dist",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@fellowship/graph": ["../graph/src/index.ts"],
      "@fellowship/core/scoring": ["../core/src/domain/scoring.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
