{
  "name": "fellowship",
  "version": "0.0.6",
  "private": true,
  "description": "Local-first tracker of the people in one person's life.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:check": "pnpm --filter @fellowship/core db:check",
    "db:generate": "pnpm --filter @fellowship/core db:generate",
    "db:migrate": "pnpm --filter @fellowship/core db:migrate",
    "db:new": "pnpm --filter @fellowship/core db:new",
    "desktop": "pnpm --filter @fellowship/desktop app",
    "dev": "pnpm --filter @fellowship/ui dev",
    "mcp": "pnpm --filter fellowship start mcp",
    "release:app": "node scripts/release-app.mjs",
    "start": "pnpm --filter fellowship start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
