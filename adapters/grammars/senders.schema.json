{
  "type": "object",
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "senderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "personId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          }
        },
        "required": [
          "senderName",
          "personId",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "matches"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
